# ============================================================================
# ATENÇÃO: toda variável VITE_* é compilada no bundle do navegador e é PÚBLICA.
# Nunca coloque chave de API, token, segredo ou credencial aqui.
# Ver specs/001-petshop-home-comercial/contracts/security-and-headers.md
# ============================================================================

# URL do endpoint que recebe a solicitação de contato.
# Vazio = modo composer (abre o WhatsApp com a mensagem pré-preenchida).
# Ver contracts/contact-endpoint.md
VITE_CONTACT_ENDPOINT=

# Domínio canônico, usado em canonical, Open Graph e JSON-LD.
VITE_SITE_URL=https://www.patasfelizes.com.br
